              "difficulty_band": 2,
              "prerequisites": ["g1m-tell-time-half"],
              "objective": "会认读 5 分、5 分整刻到整时的所有时刻。",
              "question_types": ["choice", "fill"]
            },
            {
              "id": "g2m-time-relationship",
              "name": "时间与时刻的加减",
              "difficulty_band": 3,
              "prerequisites": ["g2m-time-minute"],
              "objective": "能计算经过时间，如 8:20 到 9:00 经过多久。",
              "question_types": ["fill", "choice"]
            }
          ]
        },
        {
          "code": "g2m-u6",
          "name": "角的初步认识",
          "knowledge_points": [
            {
