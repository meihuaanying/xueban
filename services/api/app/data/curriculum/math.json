              "question_types": ["fill", "choice"]
            },
            {
              "id": "g2m-table-1-9",
              "name": "1~9 的乘法口诀",
              "difficulty_band": 2,
              "prerequisites": ["g2m-mult-sign"],
              "objective": "熟记 1~9 的乘法口诀并能正确计算表内乘法。",
              "question_types": ["oral", "fill", "choice"]
            },
            {
              "id": "g2m-table-app",
              "name": "用乘法口诀解决简单问题",
              "difficulty_band": 3,
              "prerequisites": ["g2m-table-1-9"],
              "objective": "能用乘法解决「每份几个、有几份、求总数」的简单问题。",
              "question_types": ["fill", "choice"]
            }
          ]
        },
        {
          "code": "g2m-u3",
          "name": "100 以内的加法和减法（二）",
          "knowledge_points": [
            {
              "id": "g2m-carry-mixed-100",
