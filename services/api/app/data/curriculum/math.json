              "difficulty_band": 3,
              "prerequisites": ["g2m-carry-add-100", "g2m-borrow-sub-100"],
              "objective": "会按从左到右顺序计算 100 以内加减法混合式。",
              "question_types": ["fill", "choice"]
            },
            {
              "id": "g2m-vertical-add-sub",
              "name": "连加、连减与加减混合",
              "difficulty_band": 3,
              "prerequisites": ["g2m-carry-mixed-100"],
              "objective": "会熟练计算连加、连减和加减混合式，注意运算顺序。",
              "question_types": ["fill", "oral"]
            },
            {
              "id": "g2m-estimate",
              "name": "加减法的估算",
              "difficulty_band": 3,
              "prerequisites": ["g2m-carry-add-100"],
              "objective": "能先把加数或减数看成整十数再估算结果范围。",
              "question_types": ["choice", "fill"]
            }
          ]
        },
        {
          "code": "g2m-u4",
          "name": "表内除法",
          "knowledge_points": [
            {
              "id": "g2m-div-meaning",
              "name": "平均分与除法的初步认识",
