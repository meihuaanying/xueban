              "objective": "会用乘法口诀求商，正确计算表内除法。",
              "question_types": ["oral", "fill", "choice"]
            },
            {
              "id": "g2m-div-app",
              "name": "用除法解决平均分问题",
              "difficulty_band": 3,
              "prerequisites": ["g2m-div-use-table"],
              "objective": "能用除法解决「总数÷每份数=份数」的问题。",
              "question_types": ["fill", "choice"]
            }
          ]
        },
        {
          "code": "g2m-u5",
          "name": "认识时间",
          "knowledge_points": [
            {
              "id": "g2m-time-minute",
