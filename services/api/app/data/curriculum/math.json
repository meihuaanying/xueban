            },
            {
              "id": "g2m-borrow-sub-100",
              "name": "100 以内两位数减两位数（退位）",
              "difficulty_band": 3,
              "prerequisites": ["g2m-single-digit-add", "g1m-sub-within-20-borrow"],
              "objective": "掌握竖式退位减法：个位不够减向十位借 1 当 10。",
              "question_types": ["fill", "choice", "oral"]
            }
          ]
        },
        {
          "code": "g2m-u2",
          "name": "表内乘法",
          "knowledge_points": [
            {
              "id": "g2m-mult-meaning",
