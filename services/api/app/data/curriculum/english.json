            {
              "id": "g1e-letter-a-g",
              "name": "字母 A~G 的认读",
              "difficulty_band": 1,
              "prerequisites": [],
              "objective": "能听音认形，读出 A 到 G 七个字母。",
              "question_types": ["choice", "match"]
            },
            {
              "id": "g1e-letter-h-n",
              "name": "字母 H~N 的认读",
              "difficulty_band": 1,
              "prerequisites": ["g1e-letter-a-g"],
