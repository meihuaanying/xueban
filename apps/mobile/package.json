{
  "name": "@xueban/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --coverage",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@xueban/core": "workspace:*",
    "expo": "~53.0.0",
    "expo-av": "~15.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.5",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "nativewind": "4.1.23",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@xueban/config": "workspace:*",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|nativewind|react-native-css-interop|@xueban/.*))"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/test/style-mock.js",
      "@react-native-async-storage/async-storage": "<rootDir>/test/async-storage-mock.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/navigation.ts",
      "!src/screens/profile.tsx",
      "!src/screens/learn.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80
      }
    }
  }
}
